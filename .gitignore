# ═══════════════════════════════════════════════════════════════════════════
# Rust
# ═══════════════════════════════════════════════════════════════════════════

# Build artifacts
/target/
**/target/
**/*.rs.bk

# Cargo.lock is committed for binaries, NOT for libraries.
# Signalis-core is a library, so we EXCLUDE it.
# Uncomment if you want reproducible builds for the workspace.
# Cargo.lock

# ═══════════════════════════════════════════════════════════════════════════
# Node.js
# ═══════════════════════════════════════════════════════════════════════════

# Dependencies
node_modules/
jspm_packages/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Optional npm cache
.npm
.eslintcache
.stylelintcache

# Yarn Integrity file
.yarn-integrity

# ═══════════════════════════════════════════════════════════════════════════
# Build outputs
# ═══════════════════════════════════════════════════════════════════════════

# TypeScript / tsup builds
dist/
build/
out/
*.tsbuildinfo

# NAPI-RS auto-generated files (regenerated on every build)
index.js
index.d.ts
index.d.cts
index.d.mts

# Native binaries (per-platform .node files)
*.node

# ═══════════════════════════════════════════════════════════════════════════
# Tests & Coverage
# ═══════════════════════════════════════════════════════════════════════════

coverage/
.nyc_output/
*.lcov

